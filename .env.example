# LLM API 配置 (ModelScope Qwen)
OPENAI_COMPAT_BASE_URL=https://api-inference.modelscope.cn/v1
OPENAI_COMPAT_MODEL=Qwen/Qwen3.5-27B
OPENAI_COMPAT_API_KEY=your-api-key-here

# 可选：HuggingFace Embedding 模型缓存目录
HF_HOME=./storage/hf_cache

# Supabase 配置（可选，用于加速股票搜索）
# 如果不配置，会使用本地 CSV 搜索
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Auth0 登录与 FastAPI/MCP access token 验证
AUTH0_DOMAIN=https://your-tenant.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_SECRET=generate-a-32-byte-hex-secret
APP_BASE_URL=http://localhost:3000
# 可选：配置后使用 RS256 JWT 本地校验；留空时复用 Auth0 /userinfo token
AUTH0_AUDIENCE=
AUTH0_SCOPE=openid profile email

# Next.js 服务端访问独立运行的 FastAPI；同域 Vercel 部署可不设置
API_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://localhost:3000
